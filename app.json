{
  "expo": {
    "name": "Ghost Light",
    "slug": "ghostlight",
    "scheme": "ghostlight",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ee3938d8-8f0f-4a0d-bea1-2f717ef7f911",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.actorrise.ghostlight",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Ghost Light uses device motion to move the stage light as you tilt your phone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.actorrise.ghostlight",
      "adaptiveIcon": {
        "backgroundColor": "#130b08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Ghost Light uses device motion to move the stage light as you tilt your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#130b08",
          "dark": {
            "backgroundColor": "#130b08"
          },
          "android": {
            "image": "./assets/splash-android.png",
            "imageWidth": 180,
            "backgroundColor": "#130b08",
            "dark": {
              "image": "./assets/splash-android.png",
              "backgroundColor": "#130b08"
            }
          }
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-apple-authentication",
      "expo-localization",
      "expo-secure-store",
      "expo-image",
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "note",
              "title": "Before you go…",
              "subtitle": "A note from Canberk",
              "icon": "symbol:heart"
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/withLocalNotificationsOnly.js",
      [
        "expo-notifications",
        {
          "color": "#e0731f",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee3938d8-8f0f-4a0d-bea1-2f717ef7f911"
      }
    }
  }
}
