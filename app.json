{
  "expo": {
    "name": "Ghost Light",
    "slug": "ghostlight",
    "scheme": "ghostlight",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.actorrise.ghostlight",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Ghost Light uses device motion to move the stage light as you tilt your phone."
      }
    },
    "android": {
      "package": "com.actorrise.ghostlight",
      "adaptiveIcon": {
        "backgroundColor": "#130b08",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Ghost Light uses device motion to move the stage light as you tilt your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#130b08",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#130b08",
            "image": "./assets/splash-icon.png",
            "imageWidth": 150,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
